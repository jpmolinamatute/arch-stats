# /etc/systemd/system/cloudflared.service
[Unit]
Description=cloudflared
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/cloudflared_config.yaml tunnel run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
