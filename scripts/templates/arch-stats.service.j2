[Unit]
Description={{ app_name_label }}
After=network.target postgresql.service
Wants=network-online.target

[Service]
User={{ app_name }}
Group={{ app_name }}
WorkingDirectory={{ app_user_home_dir }}/backend

# Environment variables (permissions 600, owned by {{ app_name }})
EnvironmentFile={{ app_user_home_dir }}/.env

# Run uvicorn from within the virtual environment
ExecStart={{ app_user_home_dir }}/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port {{ prod_uvicorn_port }} --workers 4

# Automatically restart if it crashes
Restart=always
RestartSec=5

# Capture logs in journald
StandardOutput=journal
StandardError=journal

# Optionally increase open file limit
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
